{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "AILA.Infrastructure.Services.Email": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PostgreSQL": "[data]",
    "Redis": "[data]"
    
  },
    "PasswordReset": {
    "RedisKeyPrefix": "pwdreset:",
    "OtpLength": 6,
    "OtpTtlSeconds": 300,
    "ResetTokenTtlSeconds": 600,
    "MaxVerifyAttempts": 5,
    "MaxOtpRequestsPerEmail": 5,
    "MaxOtpRequestsPerIp": 20,
    "RateLimitWindowSeconds": 3600,
    "MinRequestDurationMs": 350,
    "RejectPasswordSameAsCurrent": true,
    "OtpHashSecret": "[data]"
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "UseStartTls": true,
    "UserName": "[data]",
    "Password": "[data]",
    "FromEmail": "[data]",
    "FromName": "AILA",
    "TimeoutSeconds": 15,
    "MaxRetryAttempts": 3,
    "RetryDelaySeconds": 5
  },
  "JwtSettings": {
    "Key": "[data]",
    "Issuer": "AILAServer",
    "Audience": "AILAClients",
    "ExpireMinutes": 60
  },
  "GoogleSettings": {
    "ClientId": "[data]",
    "ClientSecret": "[data]",
    "RedirectUri": "https://localhost:7124/api/auth/google/callback"
  },
  "AdminAccount": {
    "Email": "[data]",
    "Password": "[data]",
    "FullName": "[data]"
  },
  "Cloudinary": {
    "CloudName": "[data]",
    "ApiKey": "[data]",
    "ApiSecret": "[data]"
  }
}